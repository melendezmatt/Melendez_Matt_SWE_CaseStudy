# Copy to .env; docker compose reads it automatically. Only the LLM key is required, and only for /ask.

# Any OpenAI-compatible /chat/completions endpoint with tool calling.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.7-flash

# Other examples:
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=<provider/model>
#   Your proxy:  LLM_BASE_URL=https://<your-proxy>/v1          LLM_MODEL=<model>

# SEC asks for a User-Agent with contact details. Only used by a live `fetch`.
SEC_USER_AGENT=FundamentalsTracker research your-email@example.com

# Limits on /ask, so slow LLM calls can't tie up the API. These are the defaults.
# ASK_TIMEOUT_SECONDS=90
# ASK_CONCURRENCY=8
